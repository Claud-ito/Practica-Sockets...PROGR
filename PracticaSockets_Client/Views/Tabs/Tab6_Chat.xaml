<UserControl x:Class="PracticaSockets_Client.Views.Tabs.Tab6_Chat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E1E2E" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sala de Chat (Full Duplex)" Foreground="#CDD6F4" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,20,0,15" Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}, FallbackValue=Visible}">
            <TextBlock Text="Usuario:" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="150" Background="#313244" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,20,0"/>
            <Button Content="Conectar al Chat" Command="{Binding ConnectCommand}" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Padding="15,8" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="#11111B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <ScrollViewer x:Name="ChatScrollViewer">
                <TextBlock Text="{Binding ChatLog}" Foreground="#CDD6F4" TextWrapping="Wrap" FontSize="14"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Hidden}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Mensaje, UpdateSourceTrigger=PropertyChanged}" Background="#313244" Foreground="White" BorderThickness="0" Padding="10" FontSize="14" Margin="0,0,10,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendMessageCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Enviar" Command="{Binding SendMessageCommand}" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Padding="20,10" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>
