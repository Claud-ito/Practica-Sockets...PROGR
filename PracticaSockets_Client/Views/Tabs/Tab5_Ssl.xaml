<UserControl x:Class="PracticaSockets_Client.Views.Tabs.Tab5_Ssl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E1E2E" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sockets Seguros con SSL/TLS" Foreground="#CDD6F4" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBox Text="{Binding Mensaje, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="#313244" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,10,0"/>
            <Button Content="Enviar Seguro (TLS)" Command="{Binding ConectarSslCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}" Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Padding="15,8" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="100" Height="10" Foreground="#CBA6F7" Background="#313244" Margin="15,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Hidden}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#11111B" CornerRadius="8" Padding="15">
            <TextBlock Text="{Binding Log}" Foreground="#94E2D5" TextWrapping="Wrap" FontFamily="Consolas"/>
        </Border>
    </Grid>
</UserControl>
